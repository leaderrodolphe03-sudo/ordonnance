# Copier ce fichier en ".env" et l'adapter au serveur.

# Port d'écoute de l'application
PORT=3000
# 0.0.0.0 = accessible depuis le réseau ; 127.0.0.1 = seulement via un reverse proxy local
HOST=0.0.0.0

# Dossier de la base de données (à inclure dans les sauvegardes du serveur)
DATA_DIR=./data

# Mot de passe du compte "admin" créé au tout premier démarrage (ignoré ensuite).
# Sans cette valeur, un mot de passe aléatoire est affiché dans la console au premier lancement.
ADMIN_PASSWORD=

# Mettre 1 si l'application est derrière IIS / Nginx / Apache (HTTPS terminé par le proxy)
TRUST_PROXY=0
# Mettre 1 si le site est servi en HTTPS (cookie de session "Secure")
COOKIE_SECURE=0

# Fuseau horaire (statistiques "aujourd'hui", sauvegardes)
TZ=Africa/Porto-Novo
